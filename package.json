{
  "name": "dsh-theme-frost",
  "version": "0.1.0",
  "private": true,
  "description": "磨砂壁纸：把 $DSH_HOME/theme-frost/wallpapers 里的图片设为 DSH 网页端的全局背景",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "author": "H2CO3w",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H2CO3w/dsh-theme-frost.git"
  },
  "homepage": "https://github.com/H2CO3w/dsh-theme-frost#readme",
  "bugs": {
    "url": "https://github.com/H2CO3w/dsh-theme-frost/issues"
  }
}
