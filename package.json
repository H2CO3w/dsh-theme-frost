{
  "name": "dsh-theme-frost",
  "version": "0.2.0",
  "private": true,
  "description": "DSH web UI wallpaper with frosted-glass surfaces, in the official palette.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "author": "H2CO3w",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H2CO3w/dsh-theme-frost.git"
  },
  "homepage": "https://github.com/H2CO3w/dsh-theme-frost#readme",
  "bugs": {
    "url": "https://github.com/H2CO3w/dsh-theme-frost/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wallpaper",
    "theme",
    "frosted-glass",
    "web-ui"
  ]
}
