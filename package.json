{
  "name": "dsh-theme-frost",
  "version": "0.1.0",
  "private": true,
  "description": "DSH(DeepSeek Harness)插件:把文件夹里的图片设为网页端全局磨砂壁纸,配色沿用官方原版。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "author": "H2CO3w",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H2CO3w/dsh-theme-frost.git"
  },
  "homepage": "https://github.com/H2CO3w/dsh-theme-frost#readme",
  "bugs": {
    "url": "https://github.com/H2CO3w/dsh-theme-frost/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "wallpaper",
    "frosted-glass",
    "web-ui"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  }
}
